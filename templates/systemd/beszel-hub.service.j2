[Unit]
Description=Beszel Hub ({{ beszel_hub_identifier }})
{% for service in beszel_hub_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in beszel_hub_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ beszel_hub_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ beszel_hub_identifier }} \
      --log-driver=none \
      --user={{ beszel_hub_uid }}:{{ beszel_hub_gid }} \
      --cap-drop=ALL \
      --security-opt=no-new-privileges \
      --read-only \
      --network={{ beszel_hub_container_network }} \
      {% if beszel_hub_container_http_host_bind_port %}
      -p {{ beszel_hub_container_http_host_bind_port }}:{{ beszel_hub_container_http_port }} \
      {% endif %}
      --env-file={{ beszel_hub_base_path }}/env \
      --label-file={{ beszel_hub_base_path }}/labels \
      --mount type=bind,src={{ beszel_hub_data_path }},dst=/beszel_data \
      {% if beszel_hub_agent_socket_enabled %}
      --mount type=bind,src={{ beszel_hub_agent_socket_path_host }},dst={{ beszel_hub_agent_socket_path_container }} \
      {% endif %}
      {% for volume in beszel_hub_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ beszel_hub_container_tmpfs_tmp_size }} \
      {% for arg in beszel_hub_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ beszel_hub_container_image }} \
      serve --http=0.0.0.0:{{ beszel_hub_container_http_port }}

{% for network in beszel_hub_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ beszel_hub_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ beszel_hub_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ beszel_hub_container_stop_grace_time_seconds }} {{ beszel_hub_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ beszel_hub_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ beszel_hub_identifier }}

[Install]
WantedBy=multi-user.target
