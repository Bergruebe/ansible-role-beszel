TZ={{ beszel_environment_variables_tz }}

APP_URL={{ beszel_app_url }}

CHECK_UPDATES={{ beszel_environment_variable_check_updates | string | lower }}
CONTAINER_DETAILS={{ beszel_environment_variable_container_details | string | lower }}
DISABLE_PASSWORD_AUTH={{ beszel_environment_variable_disable_password_auth | string | lower }}
USER_CREATION={{ beszel_environment_variable_user_creation | string | lower }}
OAUTH_DISABLE_POPUP={{ beszel_environment_variable_oauth_disable_popup | string | lower }}
MFA_OTP={{ beszel_environment_variable_mfa_otp | string | lower }}
SHARE_ALL_SYSTEMS={{ beszel_environment_variable_share_all_systems | string | lower }}

{% if beszel_environment_variable_trusted_proxy_ips %}
TRUSTED_PROXY_IPS={{ beszel_environment_variable_trusted_proxy_ips }}
{% endif %}

{% if beszel_environment_variable_trusted_auth_header %}
TRUSTED_AUTH_HEADER={{ beszel_environment_variable_trusted_auth_header }}
{% endif %}

{% if beszel_environment_variable_csp %}
CSP={{ beszel_environment_variable_csp }}
{% endif %}

{% if beszel_environment_variable_user_email and beszel_environment_variable_user_password %}
USER_EMAIL={{ beszel_environment_variable_user_email }}
USER_PASSWORD={{ beszel_environment_variable_user_password }}
{% endif %}

{{ beszel_environment_variables_additional_variables }}
